---
interface Props {
  title: string
  cols: string[]
  rows: { id: string; total: number; correct: number; wrong: number }[]
}
const { title, cols, rows } = Astro.props
---

<details>
  <summary>{title}</summary>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>{cols.map((c, i) => <th class={i ? 'num' : ''}>{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td>
                <code>{r.id}</code>
              </td>
              <td class="num">{r.total}</td>
              <td class="num">{r.correct}</td>
              <td class="num">{r.wrong}</td>
              <td class="num">{r.total - r.correct - r.wrong}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</details>
